node_modules/
dist/
data/
.env
.DS_Store
npm-debug.log*

# The Pi generates its own lockfile with npm 10 on ARM; a Windows/npm-11 one
# collides on pull and can carry wrong-platform optional binaries.
package-lock.json

# Assembled design canvases are large and rebuilt from the .dc.html sources.
design/*/*.html
!design/*/*.dc.html
