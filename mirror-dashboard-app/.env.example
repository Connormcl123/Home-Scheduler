PORT=4174
NODE_ENV=development
DATABASE_PATH=./data/mirror-dashboard.sqlite
CLIENT_DIST_PATH=./client/dist

# Weather defaults: Pittsburgh, PA. Replace with your home location.
WEATHER_LATITUDE=40.4406
WEATHER_LONGITUDE=-79.9959
WEATHER_TIMEZONE=America/New_York

# Optional iCal feed URL. Leave empty for demo calendar events.
ICAL_FEED_URL=

# RSS feeds can be edited in SQLite settings/feed table later.
DEFAULT_RSS_FEEDS=https://feeds.npr.org/1001/rss.xml,https://www.theverge.com/rss/index.xml

# Finance demo watchlist.
FINANCE_WATCHLIST=AAPL,MSFT,SPY,QQQ
FINANCE_PROVIDER=yahoo
