PORT=4174
NODE_ENV=development
DATABASE_PATH=./data/mirror-dashboard.sqlite
CLIENT_DIST_PATH=./client/dist

# Weather defaults: Pittsburgh, PA. Replace with your home location.
WEATHER_LATITUDE=40.4406
WEATHER_LONGITUDE=-79.9959
WEATHER_TIMEZONE=America/New_York

# Optional private iCal feed URL. Supports Google Calendar secret iCal URLs and iCloud published calendar URLs.
ICAL_FEED_URL=
# Optional multiple iCal feeds. Use this for several iCloud/Google calendars.
# Example: ICAL_FEED_URLS=https://calendar-1.ics,https://calendar-2.ics,https://calendar-3.ics
ICAL_FEED_URLS=

# RSS feeds can also be edited in SQLite through the Settings screen.
DEFAULT_RSS_FEEDS=https://feeds.npr.org/1001/rss.xml,https://www.theverge.com/rss/index.xml

# Finance provider: mock or yahoo. Yahoo is an unofficial test provider only.
FINANCE_WATCHLIST=AAPL,MSFT,SPY,QQQ
FINANCE_PROVIDER=yahoo

# Personal finance provider phase. local-demo seeds SQLite with sample accounts,
# budgets, and transactions. Future choices can be plaid, mx, or finicity.
PERSONAL_FINANCE_PROVIDER=local-demo

# Future bank aggregation credentials. Do not commit real keys.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_CLIENT_NAME=Home Scheduler
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PLAID_USER_ID=home-scheduler-local-user

# Future AI review integration. Do not commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
FINANCE_AI_ENABLED=false
